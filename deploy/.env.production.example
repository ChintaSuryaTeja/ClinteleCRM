# Production settings. Copy to .env.production (never committed) and fill in.
# Generate each password/secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# The site's address. "localhost" for a test run on your own computer.
DOMAIN=localhost
# Email Let's Encrypt uses for certificate expiry warnings (real server only).
LETSENCRYPT_EMAIL=
# Keep 0 until the real certificate works, then 31536000 (one year).
HSTS_MAX_AGE=0

POSTGRES_USER=clientele
POSTGRES_PASSWORD=
POSTGRES_DB=clientele

# Signs login tokens: at least 32 random characters.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# Grafana login at https://<DOMAIN>/grafana/ (user "admin").
GRAFANA_ADMIN_PASSWORD=

# Optional: the Ask screen (anthropic or google, with that provider's key).
ASK_PROVIDER=google
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Where images come from.
#   Testing on your computer (built locally):  clientele / local
#   Real server (published by GitHub Actions): ghcr.io/chintasuryateja/clintelecrm / main
IMAGE_REGISTRY=clientele
IMAGE_TAG=local

# Ports on the host. Change only if 80/443 are already taken on your computer.
HTTP_PORT=80
HTTPS_PORT=443
