# Nginx: the only part of the app reachable from the internet.
#
# This is a template: when the container starts, ${DOMAIN} and ${HSTS_MAX_AGE}
# are replaced from the environment. Nginx's own variables ($host,
# $remote_addr...) are left alone because they aren't environment variables.

# Don't advertise the Nginx version in error pages and headers.
server_tokens off;

# Login attempts: at most 10 per minute per IP address (plus a short burst),
# which slows down password guessing.
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

# Lets Grafana's live updates (websockets) pass through.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream web     { server web:3000; }
upstream api     { server api:8000; }
upstream grafana { server grafana:3000; }

# Port 80 (plain HTTP): only Let's Encrypt's domain check, everything else is
# sent to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Same limit as the API's MAX_UPLOAD_MB.
    client_max_body_size 50m;

    add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Headers passed on to the app. All proxy_set_header lines live here, at
    # server level: a location with even one proxy_set_header of its own
    # silently drops ALL of these (Nginx doesn't merge them).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # For websockets (Grafana's live updates); "close" for normal requests.
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # Internal-only API paths: Prometheus reads /metrics inside Docker; the
    # docs are also switched off in production, this is a second lock.
    location = /api/metrics       { return 404; }
    location /api/docs            { return 404; }
    location /api/redoc           { return 404; }
    location = /api/openapi.json  { return 404; }

    location = /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://api/auth/login;
    }

    # /api/... goes straight to FastAPI with the /api prefix removed (the
    # trailing slash on proxy_pass does that), so uploads don't pass through
    # Next.js. The browser still sees a single site.
    location /api/ {
        proxy_pass http://api/;
        proxy_read_timeout 120s;
    }

    location /grafana/ {
        proxy_pass http://grafana;
    }

    location / {
        proxy_pass http://web;
    }
}
