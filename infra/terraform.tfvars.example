# Copy to terraform.tfvars (git-ignored) and fill in. OCIDs are identifiers,
# not passwords, but there's no need to publish them.

region           = "ap-mumbai-1"
compartment_ocid = "ocid1.tenancy.oc1..xxxxxxxx"
ssh_allowed_cidr = "203.0.113.7/32" # your IP: https://ifconfig.me, then add /32

# Optional, all within Always Free limits:
# ocpus           = 2
# memory_gbs      = 12
# boot_volume_gbs = 100

# Optional safety net: email if the account ever costs money.
# budget_alert_email = "you@example.com"
# tenancy_ocid       = "ocid1.tenancy.oc1..xxxxxxxx"
