# Copy this file to .env and fill in real values. .env is never committed.

POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# true in production (HTTPS only), false for local http://localhost
COOKIE_SECURE=false

# Optional: an Anthropic API key enables plain-English questions (Ask screen).
# Get one at https://console.anthropic.com. Leave empty to turn the feature off.
ANTHROPIC_API_KEY=
