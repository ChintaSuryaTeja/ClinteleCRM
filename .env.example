# Copy this file to .env and fill in real values. .env is never committed.

POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# true in production (HTTPS only), false for local http://localhost
COOKIE_SECURE=false

# Optional: plain-English questions (Ask screen). Pick the AI provider and give
# its key; leave the key empty to turn the feature off.
#   anthropic: key from https://console.anthropic.com (starts with sk-ant-)
#   google:    Gemini API key from https://aistudio.google.com/apikey
ASK_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
